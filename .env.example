DATABASE_URL=postgresql://psat:psat@localhost:5433/psat
TEST_DATABASE_URL=postgresql://psat:psat@localhost:5433/psat_test

# Required in prod. Random high-entropy string sent in the X-PSAT-Admin-Key
# header for every non-GET API call. Workers and the admin UI must use it.
PSAT_ADMIN_KEY=

# Comma-separated list of origins allowed to call the API from a browser.
PSAT_SITE_ORIGIN=

# Accounts. Sign-in is off unless at least one provider's id+secret is set.
# PSAT_SESSION_SECRET signs the OAuth state cookie (>= 32 chars, random).
# OAuth callback: <PSAT_PUBLIC_BASE_URL>/api/auth/<github|google>/callback;
# PSAT_PUBLIC_BASE_URL falls back to the first PSAT_SITE_ORIGIN, then the
# request host.
PSAT_SESSION_SECRET=
PSAT_PUBLIC_BASE_URL=
PSAT_GITHUB_CLIENT_ID=
PSAT_GITHUB_CLIENT_SECRET=
PSAT_GOOGLE_CLIENT_ID=
PSAT_GOOGLE_CLIENT_SECRET=
# Verified emails whose accounts are admins; re-checked on every request.
PSAT_ADMIN_EMAILS=
# Local only: POST /api/auth/dev-login signs in as any email, and account emails
# (sign-up / reset links) are logged instead of sent. Ignored on Fly.
PSAT_AUTH_DEV_LOGIN=

# Email/password sign-in is offered only when account email can be sent.
# Any SMTP provider (Resend, SES, Mailgun, ...). Port 465 = implicit TLS,
# anything else must support STARTTLS.
PSAT_SMTP_HOST=
PSAT_SMTP_PORT=587
PSAT_SMTP_USERNAME=
PSAT_SMTP_PASSWORD=
PSAT_MAIL_FROM=

ETHERSCAN_API_KEY=

# eRPC proxy — the single front door for all hosted JSON-RPC reads (rate
# limiting, caching, multi-upstream failover). Required. PSAT routes every
# chain through ERPC_BASE_URL/main/evm/<chain_id>; there is no direct ETH_RPC
# provider fallback. An explicit per-job rpc_url is honored only for a local
# node (Anvil / test fork).
ERPC_BASE_URL=
ERPC_SECRET=

ENVIO_API_TOKEN=
TAVILY_API_KEY=
OPEN_ROUTER_KEY=

# Comma-separated allowlist of EVM chain ids PSAT is permitted to operate on
# (see utils/chains.py). Enable only chains supported by the configured RPC,
# explorer and monitoring services. Unset/blank defaults to mainnet-only ({1}).
# Example enabling supported Base (chain 8453) alongside mainnet:
# PSAT_SUPPORTED_CHAIN_IDS=1,8453
PSAT_SUPPORTED_CHAIN_IDS=1

# Optional but strongly recommended for audit discovery. Without a token
# the GitHub API rate-limits anonymous clients at 60 requests/hour, which
# isn't enough to enumerate a protocol org (vault-v2, morpho-blue,
# morpho-optimizers, metamorpho-v1.1, ...) in a single pipeline run.
# With a token the limit jumps to 5000/hour.
# Any classic PAT or fine-grained token with public-repo read access works.
GITHUB_TOKEN=

# Object storage for artifact bodies (S3-compatible).
# Local dev: minio service in docker-compose.yml.
# Production: Fly Tigris (`fly storage create`).
# Leave all four blank to fall back to inline Postgres storage (legacy mode).
ARTIFACT_STORAGE_ENDPOINT=http://localhost:9000
ARTIFACT_STORAGE_BUCKET=psat-artifacts
ARTIFACT_STORAGE_ACCESS_KEY=psat-minio
ARTIFACT_STORAGE_SECRET_KEY=psat-minio-secret

# Test bucket — used by tests/storage/test_artifact_storage_integration.py.
TEST_ARTIFACT_STORAGE_ENDPOINT=http://localhost:9000
TEST_ARTIFACT_STORAGE_BUCKET=psat-artifacts-test
TEST_ARTIFACT_STORAGE_ACCESS_KEY=psat-minio
TEST_ARTIFACT_STORAGE_SECRET_KEY=psat-minio-secret

# Rate limits
ETHERSCAN_RATE_LIMIT=5
RPC_RATE_LIMIT=15
PROTOCOL_SCAN_INTERVAL=600
PROTOCOL_POLL_INTERVAL=600
PROTOCOL_TVL_INTERVAL=3600

# Minimum age for enrollment's repair sweep on the workers machine (24 hours).
# Dirty protocols and retries still use the normal queue cadence.
# Set to 0 to restore unconditional repair eligibility on every pass.
PSAT_RECONCILE_SWEEP_MIN_AGE_S=86400

# Maximum empty-queue poll delay; resets when work is claimed.
PSAT_WORKER_IDLE_MAX_S=15
