# Copy to .env.compute and chmod 600. Activation has NOT been executed.
# Use dedicated revocable production credentials only after the documented rollout.
DATABASE_URL=postgresql://compute_user:REPLACE@database.example/psat?sslmode=verify-full
ARTIFACT_STORAGE_ENDPOINT=https://storage.example
ARTIFACT_STORAGE_BUCKET=production-artifacts
ARTIFACT_STORAGE_PREFIX=
ARTIFACT_STORAGE_ACCESS_KEY=REPLACE
ARTIFACT_STORAGE_SECRET_KEY=REPLACE
ERPC_BASE_URL=https://rpc.example/REPLACE
PSAT_RPC_ROUTING_IDENTITY=production-erpc-v1
PSAT_LOCAL_COMPUTE_ROUTING_ENABLED=0
# Match deployed analysis flags; the contract contains comparison digests.
PSAT_EFFECTS_STAGE=0
PSAT_EFFECTS_ANVIL_PORT=8546
